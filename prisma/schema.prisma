// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  JOUEUR
  ADMIN
  GAMEDESIGNER
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  role Roles @default(JOUEUR)

  username        String?
  displayUsername String?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Bakugans

enum Attribut {
  Pyrus
  Ventus
  Aquos
  Subterra
  Haos
  Darkus
}

model Bakugan {
  id                String   @id @default(uuid())
  nom               String
  attribut          Attribut
  niveauDePuissance Int      @default(250)
  image             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nom, attribut])
}

model AbilityCard {
  id          String @id @default(uuid())
  nom         String @unique
  description String
  maxPerDeck  Int    @default(3)

  // Relations
  attributs Attribut // liaison N-N avec attributs si besoin

  // Statistiques de puissance
  bonus Int @default(0) // G-Power ajouté
  malus Int @default(0) // G-Power retiré à l'adversaire

  // Effets spéciaux (booléens pour logique de jeu)
  stopGate             Boolean @default(false) // Annule tous les effets de la gate
  blockGate            Boolean @default(false) // Bloque l'ouverture de la gate adverses
  swipeGate            Boolean @default(false) // Echange la gate avec une autre
  moveSelf             Boolean @default(false) // Permet de déplacer son propre Bakugan
  moveOpponent         Boolean @default(false) // Permet de déplacer le Bakugan adverse
  moveAnOther          Boolean @default(false) // Permet de déplacer un autre bakugan qui est présent sur le champs de batail (alié ou enemie)
  attractOpponent      Boolean @default(false) // Permet d'attirer un Bakugan sur la carte portail où l'utilisateur se trouve
  cancelAbilities      Boolean @default(false) // Permet d'annuler les maitrises de l'adversaire
  protectFromGate      Boolean @default(false) // Protege contre la carte portail de l'adversaire
  protectFromAbilities Boolean @default(false) // Protège contre les maitrises de l'adversaire
  drainAbilityPower    Boolean @default(false) // Absorbe tous les points ajouté à l'adversaire

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
