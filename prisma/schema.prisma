// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  JOUEUR
  ADMIN
  GAMEDESIGNER
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  role Roles @default(JOUEUR)

  username        String?
  displayUsername String?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Bakugans

enum Attribut {
  Pyrus
  Ventus
  Aquos
  Subterra
  Haos
  Darkus
}

model Bakugan {
  id                String   @id @default(uuid())
  nom               String
  attribut          Attribut
  niveauDePuissance Int      @default(250)
  image             String

  GateCards              GateCards[]
  ExclusivesAbilityCards ExclusivesAbilityCards[] @relation("exclusivesAbilities")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nom, attribut])
}

model AbilityCard {
  id          String @id @default(uuid())
  nom         String @unique
  description String
  maxPerDeck  Int    @default(3)

  // Relations
  attributs Attribut // liaison N-N avec attributs si besoin

  // Statistiques de puissance
  bonus Int @default(0) // G-Power ajouté
  malus Int @default(0) // G-Power retiré à l'adversaire

  // Effets spéciaux (booléens pour logique de jeu)
  stopGate             Boolean @default(false) // Annule tous les effets de la gate
  blockGate            Boolean @default(false) // Bloque l'ouverture de la gate adverses
  swipeGate            Boolean @default(false) // Echange la gate avec une autre
  moveSelf             Boolean @default(false) // Permet de déplacer son propre Bakugan
  moveOpponent         Boolean @default(false) // Permet de déplacer le Bakugan adverse
  moveAnOther          Boolean @default(false) // Permet de déplacer un autre bakugan qui est présent sur le champs de batail (alié ou enemie)
  attractOpponent      Boolean @default(false) // Permet d'attirer un Bakugan sur la carte portail où l'utilisateur se trouve
  cancelAbilities      Boolean @default(false) // Permet d'annuler les maitrises de l'adversaire
  protectFromGate      Boolean @default(false) // Protege contre la carte portail de l'adversaire
  protectFromAbilities Boolean @default(false) // Protège contre les maitrises de l'adversaire
  drainAbilityPower    Boolean @default(false) // Absorbe tous les points ajouté à l'adversaire

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExclusivesAbilityCards {
  id          String @id @default(uuid())
  nom         String @unique
  description String
  maxPerDeck  Int    @default(3)

  // Relation unique à un Bakugan
  bakugan Bakugan[] @relation("exclusivesAbilities")
  // Statistiques
  bonus   Int       @default(0) // G-Power gagné
  malus   Int       @default(0) // G-Power retiré à l’adversaire

  // Effets spéciaux
  stopGate             Boolean @default(false) // annule tous les effets de la gate
  blockGate            Boolean @default(false) // empêche l’adversaire de bénéficier de la gate
  swipeGate            Boolean @default(false) // échange la gate
  moveSelf             Boolean @default(false) // déplace le Bakugan utilisateur
  moveOpponent         Boolean @default(false) // déplace le Bakugan adverse
  moveAnOther          Boolean @default(false) // Permet de déplacer un autre bakugan qui est présent sur le champs de batail (alié ou enemie)
  attractOpponent      Boolean @default(false) // permet d'attirer un Bakugan sur sa carte portail
  cancelAbilities      Boolean @default(false) // permet d'annuler les maitrises de l'adversaire
  protectFromGate      Boolean @default(false) // protege contre la carte portail de l'adversaire
  protectFromAbilities Boolean @default(false) // protège contre les maitrises de l'adversaire
  drainAbilityPower    Boolean @default(false) // Absorbe tous les points ajouté à l'adversaire

  // Équilibrage optionnel
  // rarete       Rarete   @default.RARE     // Enum à définir : RARE, ULTRA, LEGENDAIRE...
  // cout         Int      @default(2)       // coût dans le deck ou système de build
  // utilisable   Boolean  @default(true)    // activable ou non (pour gestion admin/test)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gate Card

// Card Type :

enum CardType {
  Elementary
  Character
  Command
  Trap
}

enum TargetOfCard {
  Howner
  Opponent
  All
  Winner
}

model GateCards {
  id          String   @id @default(uuid())
  nom         String   @unique
  description String
  category    CardType @default(Elementary)
  maxPerDeck  Int      @default(3)
  bakugan     Bakugan? @relation(fields: [bakuganId], references: [id])
  bakuganId   String?

  /// 🌀 ATTRIBUTS
  attributFirst  Attribut?
  attributSecond Attribut?

  // Activation automatique
  auto Boolean? @default(false) //Si c'est true, une condition d'activation effect 1 doit être précisée

  // Effets de base
  countGates    Boolean? @default(false)
  countSameAttr Boolean? @default(false)
  turnLimit     Int?     @default(0)

  // Conditions d'activation effet 1
  Effect1_Conditions_MinBakugans Int?    @default(0) // Le première effet de la carte s'active quand le nombre de bakugan attendu est atteint (seulement si ce champs est > 0 )
  Effect1_Conditions_FightEnd    Boolean @default(false) // Le premier effet de la carte s'active à la fin du combat (ex: Sand Trap empêche le gagnant de quitter le champ de batail)

  // Cible de l'effet 1
  Effect1_target TargetOfCard?

  // Effets 1
  Effect1_bonus                  Int? // 0 | 50 | 75 | 100 | 200
  Effect1_malus                  Int?
  Effect1_elimination            Boolean? @default(false)
  Effect1_blockElementAbilities  Boolean? @default(false)
  Effect1_blockEntries           Boolean? @default(false)
  Effect1_noRetreat              Boolean? @default(false)
  Effect1_twoBasePower           Boolean? @default(false)
  Effect1_swipePower             Boolean? @default(false)
  Effect1_drainOponent           Boolean? @default(false)
  Effect1_changeTargetAttr       Boolean? @default(false) //Si à true, il devient obligatoire de renseigner 1 attribut
  Effect1_changeAttrExeptSecAtrr Boolean? @default(false) // Si à true, il devient obligatoire de renseigner 2 attribut
  Effect1_addCard                Int?     @default(0)

  // Conditions d'activation effet 2
  Effect2_Conditions_MinBakugans Int?    @default(0) // Le deuième effet de la carte s'active quand le nombre de bakugan attendu est atteint (seulement si ce champs est > 0 )
  Effect2_Conditions_FightEnd    Boolean @default(false) // Le deuxième effet de la carte s'active à la fin du combat (ex: Sand Trap empêche le gagnant de quitter le champ de batail)

  // Cible de l'effet 2
  Effect2_target TargetOfCard?

  // Effets 2
  Effect2_bonus                  Int? // 0 | 50 | 75 | 100 | 200
  Effect2_malus                  Int?
  Effect2_elimination            Boolean? @default(false)
  Effect2_blockElementAbilities  Boolean? @default(false)
  Effect2_blockEntries           Boolean? @default(false)
  Effect2_noRetreat              Boolean? @default(false)
  Effect2_twoBasePower           Boolean? @default(false)
  Effect2_swipePower             Boolean? @default(false)
  Effect2_drainOponent           Boolean? @default(false)
  Effect2_changeTargetAttr       Boolean? @default(false)
  Effect2_changeAttrExeptSecAtrr Boolean? @default(false)
  Effect2_addCard                Int?     @default(0)
}
